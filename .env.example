# Postgres connection string from Neon (or Supabase)
DATABASE_URL=

# Resend API key
RESEND_API_KEY=

# Sender email
RESEND_FROM_EMAIL="Vantoz Events <onboarding@resend.dev>"

# Email address for quote requests and contact messages
VANTOZ_NOTIFY_EMAIL=hello@vantozevents.com

# Auth.js / NextAuth secret
# Generate locally with: npx auth secret
AUTH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public Cloudinary configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
